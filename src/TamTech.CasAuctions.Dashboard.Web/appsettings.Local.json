{
  "WebApplicationSettings": {
    "App_Url": "https://localhost:44377",
    "Routing_DefaultArea": "admin",
    "DurationOfLogin": 30,
    "App_CacheMenus": false,
    "App_FilesTypesSettings": {
      "FilesTypes": [
        {
          "File": "General",
          "Type": "general"
        },
        {
          "File": "PageMainImage",
          "Type": "main-content"
        },
        {
          "File": "EditorImages",
          "Type": "editor"
        }
      ]
    }
  },
  "BackendAPIsSettings": {
    "AuctionApiUrl": "https://casauctions-stage-auctionservice-api.azurewebsites.net",
    "ChatApiUrl": "https://casauctions-stage-chat-api.azurewebsites.net",
    "IdentityApiUrl": "https://casauctions-stage-identity.azurewebsites.net/"
  },
  "ApplicationInsights": {
    "InstrumentationKey": "76526fbf-4e9d-452a-b939-6cff28558f1c"
  },
  "HealthChecksSettings": {
    "HealthChecks": [
      {
        "Name": "POS - Web Application",
        "Uri": "api/health"
      }
    ],
    "EvaluationTimeOnSeconds": 3600,
    "MinimumSecondsBetweenFailureNotifications": 1800
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "System": "Information",
      "Microsoft": "Information"
    },
    "SeriLog": [
      {
        "PathFormat": "Logs/log-error-pos-app-{Date}.txt",
        "MinimumLevel": "Warning",
        "FileSizeLimitBytes": "10000000"
      }
    ]
  }
}
