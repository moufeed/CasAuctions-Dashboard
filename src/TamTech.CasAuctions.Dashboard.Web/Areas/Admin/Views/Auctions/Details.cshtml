@model AuctionDetails

@{
    ViewData["Title"] = "auction details";


    bool ShowCurrency = Model.CurrencyGrade != null || Model.CurrencyPickNumber != null || Model.CurrencyDenomination != null || Model.CurrencyCountry != null || Model.CurrencyYear != null;
}

<style>
    .dl-horizontal dt {
        text-align: left;
    }
</style>


<if include-if="Model != null">
    <div class="clearfix">
        <div class="page-title">
            <div class="title_left">
                <h3>
                    @Localizer["auction details"]
                    <small></small>
                </h3>
            </div>
            <div class="title_right">
                <a asp-action="Index"
                   class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_list"]</a>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            @{
                ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { { "id", Model.Id } };
            }
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")

            <style>
                .detials dt, .detials dd {
                    padding: 7px 5px;
                }
            </style>

        </div>

    </div>
    <div class="row">
        <div class="col-md-4 col-sm-6 col-xs-12">
            <div class="x_panel">
                <div class="x_title clearfix">
                    <h2>@Localizer["Main Info"]</h2>
                </div>
                <div class="x_content">
                    <dl class="dl-horizontal detials">
                        <dt>
                            @Localizer["Title"]
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.ItemTitle)
                        </dd>
                        <dt>
                            @Localizer["Status"]
                        </dt>
                        <dd>
                            <span class="badge badge-light">
                                 @Html.DisplayFor(model => model.StatusName)
                            </span> 
                        </dd>
                        <dt>
                            @Localizer["Category"]
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.CategoryName)
                        </dd>
                        <dt>
                            @Localizer["Type"]
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.TypeName)
                        </dd>
                        <dt>
                            @Localizer["Increment Type"]
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.IncrementTypeName)
                        </dd>
                    </dl>
                </div>




            </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12">
            <div class="x_panel">
                <div class="x_title clearfix">
                    <h2>@Localizer["Date & Time Info"]</h2>
                    <ul class="nav navbar-right panel_toolbox">

                        <li class="dropdown">
                            <a href="#" class="dropdown-toggle" data-toggle="dropdown" role="button" aria-expanded="false">
                                <i class="fa fa-clock-o"></i> Time Zone
                            </a>
                            <ul class="dropdown-menu" role="menu">
                                <li>
                                    <a href="#" onclick="utcTime(true)">UTC Zone</a>
                                </li>
                                <li>
                                    
                                    <a href="#" onclick="utcTime(false)">Local Zone</a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>
                <div class="x_content">
                    <dl class="dl-horizontal detials">
                        <dt>
                            @Localizer["Created Date"]
                        </dt>
                        <dd>
                            <span class="utc"> @Html.DisplayFor(model => model.CreatedDate) <small class="label label-info">UTC</small></span>
                            <span class="local hidden">@Model.CreatedDate.ToLocalTime()</span>
                        </dd>
                        <dt>
                            @Localizer["Modified Date"]
                        </dt>
                        <dd>

                            <span class="utc"> @Model.ModifiedDate <small class="label label-info">UTC</small></span>
                            <span class="local hidden"> @Model.ModifiedDate.ToLocalTime()</span>
                        </dd>
                        <dt>
                            @Localizer["Start Date"]
                        </dt>
                        <dd>

                            <span class="utc">@Model.StartDate <small class="label label-info">UTC</small></span>
                            <span class="local hidden">@Model.StartDate.ToLocalTime()</span>
                        </dd>
                        <dt>
                            @Localizer["End Date"]
                        </dt>
                        <dd>


                            <span class="utc">@Model.EndDate <small class="label label-info">UTC</small></span>
                            <span class="local hidden">@Model.EndDate.ToLocalTime()</span>
                        </dd>
                        <dt>
                            @Localizer["Actual End Date"]
                        </dt>
                        <dd>

                            <span class="utc">@Model.ActualEndDate <small class="label label-info">UTC</small></span>
                            <span class="local hidden">@Model.ActualEndDate</span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 col-xs-12">
            <div class="x_panel">
                <div class="x_title clearfix">
                    <h2>@Localizer["Prices Info"]</h2>
                </div>
                <div class="x_content">
                    <dl class="dl-horizontal detials">
                        <dt>
                            @Localizer["Start Price"]
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.StartPrice)
                        </dd>
                        <dt>
                            @Localizer["Limit Price"]
                        </dt>
                        <dd>
                            @if (Model.LimitPrice != null)
                            {
                                @Html.DisplayFor(model => model.LimitPrice)
                            }
                            else
                            {
                                <i class="fa fa-times"></i>
                            }
                        </dd>
                        <dt>
                            @Localizer["Purchase Price"]
                        </dt>
                        <dd>
                            @if (Model.PurchasePrice > 0)
                            {
                                @Html.DisplayFor(model => model.PurchasePrice)
                            }
                            else
                            {
                                <i class="fa fa-times"></i>
                            }
                        </dd>
                        <dt>
                            @Localizer["Maximum Participants"]
                        </dt>
                        <dd>
                            @if (Model.MaximumParticipants != null)
                            {
                                @Html.DisplayFor(model => model.MaximumParticipants)
                            }
                            else
                            {
                                <i class="fa fa-times"></i>
                            }

                        </dd>
                        <dt>
                            @Localizer["ExtendedTime"]
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.ExtendedTime)
                        </dd>

                    </dl>
                </div>
            </div>
        </div>

        <if include-if="ShowCurrency">
            <div class="col-md-4 col-sm-6 col-xs-12">
                <div class="x_panel">
                    <div class="x_title clearfix">
                        <h4>@Localizer["Currency Info"]</h4>
                    </div>
                    <div class="x_content">
                        <dl class="dl-horizontal detials">

                            <dt>
                                @Localizer["Currency Grade"]
                            </dt>
                            <dd>
                                @Html.DisplayFor(model => model.CurrencyGrade)
                            </dd>

                            <dt>
                                @Localizer["Currency Denomination"]
                            </dt>
                            <dd>
                                @Html.DisplayFor(model => model.CurrencyDenomination)
                            </dd>

                            <dt>
                                @Localizer["Currency Country"]
                            </dt>
                            <dd>
                                @Html.DisplayFor(model => model.CurrencyCountry)
                            </dd>


                            <dt>
                                @Localizer["Currency Year"]
                            </dt>
                            <dd>
                                @Html.DisplayFor(model => model.CurrencyYear)
                            </dd>


                            <dt>
                                @Localizer["Currency PickNumber"]
                            </dt>
                            <dd>
                                @Html.DisplayFor(model => model.CurrencyPickNumber)
                            </dd>


                        </dl>
                    </div>
                </div>
            </div>
        </if>

       
    
        <div class="col-md-12 col-sm-12 col-xs-12">
            <div class="x_panel">
                <div class="x_title clearfix">
                    <h4> @Localizer["Other Info"]</h4>
                </div>
                <div class="x_content">
                    <dl class="dl-horizontal detials">
                        <dt>
                            @Localizer["Participants Count"]
                        </dt>
                        <dd>
                            @if (Model.ParticipantsCount > 0)
                            {
                                @Html.DisplayFor(model => model.ParticipantsCount)
                            }
                            else
                            {
                                <i class="fa fa-times"></i>
                            }

                        </dd>
                        <dt>
                            @Localizer["Outbids Count"]
                        </dt>
                        <dd>
                            @if (Model.OutbidsCount > 0)
                            {
                                @Html.DisplayFor(model => model.OutbidsCount)
                            }
                            else
                            {
                                <i class="fa fa-times"></i>
                            }

                        </dd>
                        <dt>
                            @Localizer["Description"]
                        </dt>
                        <dd>
                            @Html.DisplayFor(model => model.ItemDescription)
                        </dd>

                    </dl>
                </div>
            </div>
        </div>
    </div>
   
    


    <div class="row">
        <if include-if="Model.SellerProfile != null">
            @{
                var Seller = Model.SellerProfile;
            }
            <div class="col-md-4 col-sm-6 col-xs-12">
                <div class="well profile_view clearfix">
                    <div class="col-sm-12">

                        <div class="left col-xs-6">
                            <h4> @Localizer["Seller"]</h4>
                            <strong>@Seller.FullName</strong>
                        </div>
                        <div class="right col-xs-6 text-right">
                            <img src="@Seller.Photo" alt="" class=" img-responsive img-thumbnail"   style="height:125px">
                        </div>
                    </div>

                </div>


            </div>
        </if>
        <if include-if="Model.BuyerProfile != null">
            @{
                var Buyer = Model.BuyerProfile;
            }
            <div class="col-md-4 col-sm-6 col-xs-12">
                <div class="well profile_view clearfix">
                    <div class="col-sm-12">

                        <div class="left col-xs-6">
                            <h4> @Localizer["Buyer"]</h4>
                            <strong>@Buyer.FullName</strong>
                            <p>
                                @Localizer["display Buyer"]  
                                @if (Model.DisplayBuyer)
                                                        {
                                                            <i class="fa fa-check"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="fa fa-times"></i>
                                                        }
                            </p>
                            
                        </div>
                        <div class="right col-xs-6 text-right">
                            <img src="@Buyer.Photo" alt="" class=" img-responsive img-thumbnail" style="height:125px">
                        </div>
                    </div>

                </div>


            </div>

        </if>

    </div>
   




    <if include-if="Model.ItemImages != null && Model.ItemImages.Count > 0">
        <div class="x_panel">
            <div class="x_title clearfix">
                <h2>@Localizer["Photos List"]</h2>
            </div>
            <div class="x_content p-y-5 ">

                <div class="row">
                    @foreach (var item in Model.ItemImages)
                    {
                        <div class="col-md-2 col-sm-3">
                            <div class="gi-card">
                                <a href="@item.Original" class="gi-image" data-lightbox="images" data-title="@Model.ItemTitle">
                                    <img src="@item.Thumb" class="img-responsive">
                                </a>
                            </div>
                        </div>
                    }
                </div>

            </div>
        </div>
    </if>



    <div class="x_panel">
        <div class="x_content">

            <div class=" ">
                <h4 class="m-b3">@Localizer["More Details"]</h4>
                <ul class="nav nav-tabs sub-tabs" role="tablist">
                    <if include-if="Model.Participants != null">
                        <li role="presentation" class="">
                            <a href="#Participants" aria-controls="Participants" role="tab" data-toggle="tab">@Localizer["Participants"]</a>
                        </li>
                    </if>
                    <if include-if="Model.Outbids != null">
                        <li role="presentation" class="">
                            <a href="#Outbids" aria-controls="Outbids" role="tab" data-toggle="tab">@Localizer["Outbids"]</a>
                        </li>
                    </if>

                    <if include-if="Model.StepsHistory != null">
                        <li role="presentation" class="active">
                            <a href="#StepsHistory" aria-controls="StepsHistory" role="tab" data-toggle="tab">@Localizer["History"]</a>
                        </li>
                    </if>

                    <if include-if="Model.IncrementAmounts != null">
                        <li role="presentation" class="">
                            <a href="#IncrementAmounts" aria-controls="IncrementAmounts" role="tab" data-toggle="tab">@Localizer["Increment Amounts"]</a>
                        </li>
                    </if>

                </ul>


                <div class="tab-content">

                    <if include-if="Model.Participants != null ">
                        <div role="tabpanel" class="tab-pane fade p-y-5" id="Participants">

                            <table class="table table-striped table-bordered">
                                <tr>
                                    <th width="120px">@Localizer["Photo"]</th>
                                    <th>@Localizer["Full name"]</th>
                                </tr>

                                <if include-if="Model.Participants.Count > 0">
                                    @foreach (var part in Model.Participants)
                                    {
                                        <tr>
                                            <td>
                                                @if (part.Photo != null)
                                                {
                                                    <img src="@part.Photo" class="img-responsive" />
                                                }
                                            </td>
                                            <td>
                                                @part.FullName
                                            </td>
                                        </tr>
                                    }

                                </if>
                            </table>
                        </div>
                    </if>
                    <if include-if="Model.Outbids != null ">
                        <div role="tabpanel" class="tab-pane fade p-y-5" id="Outbids">

                            <table class="table table-striped table-bordered">
                                <tr>
                                    <th width="75">@Localizer["Image"]</th>
                                    <th width="250">@Localizer["Participant name"]</th>
                                    <th>@Localizer["Price"]</th>
                                    <th width="250">@Localizer["Date"]</th>
                                </tr>
                                @foreach (var outbid in Model.Outbids)
                                {
                                    <tr>
                                        <td>
                                            @if (!string.IsNullOrEmpty(outbid.Profile.Photo))
                                            {
                                                <img src="@outbid.Profile.Photo" class="img-responsive" />
                                            }
                                    </td>
                                    <td>@outbid.Profile.FullName</td>
                                    <td>@outbid.Price</td>
                                    <td>@outbid.CreatedDate</td>
                                </tr>
                            }
                            </table>
                        </div>
                    </if>
                    <if include-if="Model.StepsHistory != null ">
                        <div role="tabpanel" class="tab-pane fade in active p-y-5" id="StepsHistory">



                            <table class="table table-striped table-bordered">
                                <tr>
                                    <th>@Localizer["Current status"]</th>
                                    <th>@Localizer["Previous status"]</th>
                                    <th>@Localizer["Created date"]</th>
                                    <th>@Localizer["Notes"]</th>
                                </tr>
                                <if include-if="Model.StepsHistory.Count > 0">
                                    @foreach (var step in Model.StepsHistory)
                                    {
                                        <tr>
                                            <td>@step.CurrentStatusName</td>
                                            <td>@step.PreviousStatusName</td>
                                            <td>@step.CreatedDate</td>
                                            <td>@step.Notes</td>
                                        </tr>
                                    }
                                </if>
                            </table>

                        </div>
                    </if>
                    <if include-if="Model.IncrementAmounts != null ">
                        <div role="tabpanel" class="tab-pane fade p-y-5" id="IncrementAmounts">
                            <table class="table table-striped table-bordered">
                                <tr>
                                    <th>Increment amount</th>
                                    <th>Reached limit</th>
                                </tr>
                                <if include-if="Model.IncrementAmounts != null && Model.IncrementAmounts.Count > 0">
                                    @foreach (var itm in Model.IncrementAmounts)
                                    {
                                        <tr>
                                            <td>@itm.IncrementAmount</td>
                                            <td>@itm.ReachedLimit</td>
                                        </tr>
                                    }
                                </if>
                            </table>
                        </div>
                    </if>


                </div>
            </div>


        </div>
    </div>

    <if include-if="Model.ProcessActions != null && Model.ProcessActions.Count > 0">
        <div class="x_panel">
            <div class="x_title clearfix">
                <h4>@Localizer["Process"]</h4>
            </div>
            <div class="x_content p-y-5 ">
                <div class="" id="form">
                    @{
                        List<ProcessActionModel> Actions = Model.ProcessActions;
                    }
                    <div class="pos-actions ">
                        <form asp-action="setAction" method="post" class="form m-y-5" id="takenAction">
                            <input type="hidden" name="ReqId" value="@Model.Id" />
                            <div class="form-group clearfix">
                                <label class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["Actions"] </label>
                                <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                                    @foreach (ProcessActionModel act in Actions)
                                    {
                                        <span class="m-x-3">
                                            <label for="Action-@act.ActionId">
                                                <input type="radio" name="ActionId" id="Action-@act.ActionId" value="@act.ActionId" class="check" data-note='@(act.NoteMandatory ? "true" : "false" )' required @(Model.StatusName)>
                                                <span class="check-txt">@act.Name</span>
                                            </label>
                                        </span>
                                    }
                                    <div class="actionId-errors"></div>
                                </div>
                            </div>

                            <div class="form-group clearfix">
                                <label class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["l_notes"] </label>
                                <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                                    <textarea rows="5" class="form-control action_note" name="Notes"></textarea>
                                </div>
                            </div>
                            <div class="form-group">
                                <div class="col-md-6 col-md-offset-2 col-sm-offset-3 col-sm-6 col-xs-12 ">
                                    <input type="submit" class="btn btn-success p-x-5 ut-save-btn" name="save" value="@Localizer["send"]">

                                </div>
                            </div>
                        </form>

                    </div>

                </div>
            </div>
        </div>




    </if>




</if>
<if exclude-if="Model != null">
    <partial name="~/Areas/Admin/Views/Shared/_empty.cshtml" />
</if>





@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/Admin/js/auctions.min.js"></script>


    <script src="~/Admin/js/lightbox.min.js"></script>
    <script>

        function utcTime(utc) {
            if (utc) {
                $('.utc').removeClass('hidden');
                $('.local').addClass('hidden');
            } else {
                $('.local').removeClass('hidden');
                $('.utc').addClass('hidden');
            }
        }
        lightbox.option({
            'resizeDuration': 400,
            'wrapAround': true,
            'showImageNumberLabel': false
        })
    </script>

}
 