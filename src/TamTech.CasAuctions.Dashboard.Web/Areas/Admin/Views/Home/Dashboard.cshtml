
@using System.Linq;
@{
    Layout = "_Layout";
    ViewData["Title"] = Localizer["home_page"];
}

@section Scripts{
    <partial name="~/Areas/Admin/Views/Shared/_ValidationScriptsPartial.cshtml" />
    <script>
        var Urls = {
            "#AuctionsChart": "@Url.AdminUrl("AuctionsStatistics" ,"Home")",
            "#DSItemsChart": "@Url.AdminUrl("DSItemsStatistics" ,"Home")",
            "#activeusers" :  "@Url.AdminUrl("activeUsersStatistics" ,"Home")"
        };
        var previousValue = {
            "#AuctionsChart":"d",
            "#DSItemsChart":"d"
        };
    </script>
    <script src="~/Admin/js/cahrt.min.js"></script>
    <script src="~/Admin/js/statistics.min.js"></script>
}





<section class="m-t5">
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                <div class="x_panel tile">
                    <div class="x_title clearfix ">
                        <h4>@Localizer["Auctions"]</h4>
                    </div>
                    <div class="x_content p-3 widget-flex" id="AuctionsChart">
                        <div class="chart-container">
                            <div class="chart-options">
                                @{
                                    string Auctions = "#AuctionsChart";
                                }
                                <partial name="~/Areas/Admin/Views/Home/Partials/_ChartForm.cshtml" model="Auctions" />
                            </div>
                            <div class="chart-area">
                                <div class="chart-loading">
                                    <div class="lds-ripple">
                                        <div class="lds-pos"></div>
                                        <div class="lds-pos"></div>
                                    </div>
                                </div>
                                <canvas style="display:none"></canvas>
                                <div class="svg-no-data">
                                    <partial name="~/Areas/Admin/Views/Home/Partials/_SvgNoData.cshtml" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>


            <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                <div class="x_panel tile">
                    <div class="x_title clearfix ">
                        <h4>@Localizer["DSItems"]</h4>
                    </div>
                    <div class="x_content p-3 widget-flex" id="DSItemsChart">
                        <div class="chart-container">
                            <div class="chart-options">
                                @{
                                    string DSItems = "#DSItemsChart";
                                }
                                <partial name="~/Areas/Admin/Views/Home/Partials/_ChartForm.cshtml" model="DSItems" />
                            </div>
                            <div class="chart-area">
                                <div class="chart-loading">
                                    <div class="lds-ripple">
                                        <div class="lds-pos"></div>
                                        <div class="lds-pos"></div>
                                    </div>
                                </div>
                                <canvas style="display:none"></canvas>
                                <div class="svg-no-data">
                                    <partial name="~/Areas/Admin/Views/Home/Partials/_SvgNoData.cshtml" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>







        </div>

        <div class="row">
            <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                <div class="x_panel tile">
                    <div class="x_title clearfix ">
                        <h4>@Localizer["Users"]</h4>
                    </div>
                    <div class="x_content p-3  widget-flex">
                        @if (ViewBag.UsersChart != null)
                        {

                            int total = (ViewBag.UsersChart.Data as List<int>).Sum();

                            <canvas id="cahrt" class="chart-widget"
                                    data-values="[@(string.Join(",", ViewBag.UsersChart.Data))]"
                                    data-chart-type="doughnut"
                                    data-labels="@(string.Join(",", ViewBag.UsersChart.Labels))"
                                    data-backgrounds="#7AC8A9-#A9E5F7-#F2CB00"
                                    data-hover-colors="#5dbc97-#93e2fa-#e9c400"
                                    data-border-colors="#69ad92-#78bfd4-#c1a304"
                                    data-legend-position="right"
                                    data-legend-display="true"
                                    data-legend-padding="15"
                                    data-legend-align="start"
                                    data-center-display="true"
                                    data-center-text="@total"> </canvas>
                        }

                    </div>
                </div>
            </div>






            <div class="col-xs-12 col-sm-6 col-md-6 col-lg-6">
                <div class="x_panel tile">
                    <div class="x_title clearfix ">

                        <h4>@Localizer["ActiveUsers"]</h4>
                    </div>
                    <div class="x_content p-3  wiflex">
                        <div class="clearfix">
                            <div class="tile_count">
                                <div class=" col-sm-6 col-md-3  tile_stats_count">
                                    <span class="count_top"><i class="fa fa-user green"></i> @Localizer["last_6_hours"]</span>
                                    <div class="count">@ViewBag.hourlyUsers</div>

                                </div>

                                <div class=" col-sm-6 col-md-3  tile_stats_count">
                                    <span class="count_top"><i class="fa fa-user green"></i> @Localizer["last_day"]</span>
                                    <div class="count">@ViewBag.dailyUsers</div>

                                </div>

                                <div class="col-sm-6 col-md-3  tile_stats_count">
                                    <span class="count_top"><i class="fa fa-user green"></i> @Localizer["last_week"]</span>
                                    <div class="count">@ViewBag.weeklyUsers</div>

                                </div>
                                <div class="col-sm-6 col-md-3  tile_stats_count">
                                    <span class="count_top"><i class="fa fa-user green"></i> @Localizer["last_month"]</span>
                                    <div class="count ">@ViewBag.MonthlyUsers</div>

                                </div>
                            </div>
                        </div>
                        <hr />
                        <h5 class="m-b4"><i class="fa fa-user"></i>  @Localizer["customDate"]</h5>
                        <div class="row mt-25">
                            <div class="col-sm-12  col-md-10">
                                <form class="row customForm" >
                                    <div class="from-group col-md-12 col-lg-5">
                                        <label for="">@Localizer["from_date"]</label>
                                        <input type="datetime-local" name="fromdate" class="form-control" required />
                                    </div>
                                    <div class="from-group col-md-12 col-lg-5">
                                        <label for="">@Localizer["to_date"]</label>
                                        <input type="datetime-local" name="todate" class="form-control" required />
                                    </div>
                                    <div class="from-group col-md-12 col-lg-2">

                                        <button class="btn btn-success m-t5"> @Localizer["send"]</button>
                                    </div>
                                </form>
                            </div>
                            <div class="col-sm-12 col-md-2 ">

                                <div>
                                    <h2 class="count-number m-t5"></h2>
                                    <div class="" id="loader" style="display:none">
                                        <div class="lds-ripple" style="margin: 2px 25%;">
                                            <div class="lds-pos"></div>
                                            <div class="lds-pos"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>


                </div>
            </div>
        </div>




    </div>
    </div>
</section>
