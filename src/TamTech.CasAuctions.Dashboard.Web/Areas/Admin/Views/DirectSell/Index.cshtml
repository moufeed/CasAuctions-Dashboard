
@model DsItemsList
@using TamTech.CasAuctions.Dashboard.SDK.Core.Helpers.Converters
@{
    ViewData["Title"] = Localizer["direct sell items"];
    ViewData["UnitTestPageClass"] = "ut-dsitems";
    var activeLang = DataCultureHelper.GetCurrent(Context.Request.Query);


}
@functions {
    public string TruncateAtWord(string input, int length)
    {
        if (input == null || input.Length < length)
            return input;
        int iNextSpace = input.LastIndexOf(" ", length, StringComparison.Ordinal);
        return string.Format("{0}…", input.Substring(0, (iNextSpace > 0) ? iNextSpace : length).Trim());
    }
}


<div class="clearfix">
    <div class="page-title">
        <div class="title_left">
            <h3>@Localizer["direct sell items"] <small></small></h3>
        </div>
        <div class="title_right">

        </div>
    </div>
</div>


<if include-if="Model != null">
    <div class="row">
        <div class="col-md-12 col-sm-12 col-xs-12">
            @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")
            <div class="x_panel p-x-0">
                <div class="x_content">
                    <partial name="_Filters.cshtml" model="ViewBag.FilterModel" />
                    <div class="table-responsive datatable drag">
                        <table class="table table-middle table-striped  table-hover  padding-10" id="pagesTable" style="table-layout: fixed;user-select: none;">
                            <thead>
                                <tr>

                                    <th width="250">@Localizer["t_title"] </th>
                                    <th width="300">@Localizer["t_description"]</th>
                                    <th width="150">@Localizer["t_category"]</th>
                                    <th width="175">@Localizer["created_date"]</th>
                                    <th width="175">@Localizer["end_date"]</th>
                                    <th width="200">@Localizer["t_status"]</th>
                                    <th width="200">@Localizer["SellerName"]</th>
                                    <th width="150" class="text-center">@Localizer["t_details"]</th>
                                </tr>
                            </thead>
                            <tbody>
                                <if include-if="Model.Data != null && Model.Data.Count > 0">
                                    @foreach (DsItem item in Model.Data)
                                    {
                                        <tr>
                                            <td>
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   title="@Localizer["t_details"]"
                                                   href="@Url.AdminUrl("Details" , "DirectSell",new { id = item.Id })">
                                                    @item.ItemTitle
                                                </a>

                                            </td>
                                            <td>

                                                <a tabindex="0"
                                                   class="link"
                                                   role="button" data-toggle="popover"
                                                   data-trigger="focus"
                                                   title="Dismissible popover"
                                                   data-content="@item.ItemDescription">
                                                    @TruncateAtWord(item.ItemDescription, 40)
                                                </a>
                                            </td>
                                            <td>@item.CategoryName</td>

                                            <td>@item.CreatedDate</td>
                                            <td>@item.EndDate</td>

                                            <td>@item.StatusName</td>

                                            <td>@item.SellerProfile.FullName</td>
                                            @*<td>@item.OutbidsCount</td>
                                                <td>@item.MaximumParticipants</td>*@

                                            <td>
                                                <a data-toggle="tooltip"
                                                   data-placement="top"
                                                   title="@Localizer["t_details"]"
                                                   href="@Url.AdminUrl("Details" , "DirectSell",new { id = item.Id })"
                                                   class="btn btn-view btn-round ">
                                                    <i class="fa fa-bolt" aria-hidden="true"></i>
                                                </a>


                                                <if include-if='item.StatusName == "active" '>
                                                    <a data-toggle="modal"
                                                       data-target="#cancelModal"
                                                       data-id="@item.Id"
                                                       class="btn btn-remove btn-round ">
                                                        <i class="fa fa-times"
                                                           title="@Localizer["cancel"]"
                                                           aria-hidden="true"
                                                           data-toggle="tooltip"
                                                           data-placement="left"></i>
                                                    </a>
                                                </if>
                                            </td>
                                        </tr>

                                    }
                                </if>
                                <if exclude-if="Model.Data != null && Model.Data.Count > 0">
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            <p class="empty_row">
                                                <i class='fa fa fa-exclamation-circle'></i>
                                                @Localizer["no_data_table"]
                                            </p>
                                        </td>
                                    </tr>
                                </if>

                            </tbody>
                        </table>
                    </div>
                    <hr class="m-y-2" />
                    <pagination controller-name="DirectSell" filter-model="ViewBag.FilterModel" pagniation-model="Model.Pagination" total="true"></pagination>
                </div>
            </div>
        </div>
    </div>
</if>


<if exclude-if="Model != null">
    <partial name="~/Areas/Admin/Views/Shared/_empty.cshtml" />
</if>


<!-- Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1" role="dialog" aria-labelledby="cancelModal">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form asp-action="setAction" method="post" class="form m-y-5" id="takenAction">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
                    <h4 class="modal-title" id="cancelModal">
                        @Localizer["Cancel Direct Sell Item"]
                    </h4>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="ReqId" id="reqId" value="" />
                    <input type="hidden" name="ActionId" value="2" />
                    <div class="form-group clearfix">
                        <label class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["l_notes"] </label>
                        <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                            <textarea rows="5" class="form-control action_note" name="Notes" style="resize:vertical" id="notes"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-default" data-dismiss="modal">@Localizer["Close"]</button>
                    <button type="submit" class="btn btn-danger">@Localizer["cancel dsitem"]</button>
                </div>
            </form>
        </div>
    </div>
</div>




@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>


        $('#cancelModal').on('show.bs.modal', function (e) {
            var id = $(e.relatedTarget).data('id');
            var modal = $(e.target);
            modal.find("#reqId").val(id);
             
        });

          $('#cancelModal').on('hidden.bs.modal', function (e) {
              $(e.target).find('#takenAction').trigger("reset");
        });


        $(document).ready(() => {
             
            $('#takenAction').validate({
                errorClass: "invalid_field",
                validClass: "valid_field",
                ignore: ".ignore",
                submitHandler: function (form) {
                    let action = $(form).attr("action");
                    $.ajax({
                        url: action,
                        type: "POST",
                        data: $(form).serialize(),
                        cache: false,
                        processData: false,
                        success: function (data) {
                            $('#cancelModal').modal('hide');
                            if (data.success) {
                                let _data = data.result.data;
                                $('#takenAction').trigger("reset");
                                $notification.success("", window.localization.processed_successfully, 2000, "fa fa-check");
                                setTimeout(() => window.location.reload(), 1000);
                            } else {
                                var errors = data.errors;
                                if (errors.length > 0) {
                                    let txt = MakeErrorsMsg(errors);
                                    $notification.error("", txt, 3500, "fa fa-exclamation-circle");
                                }
                            }
                        }
                    });
                    return false;
                }
            })

        })
    </script>
}

