@model DsItemDetails

@{
    ViewData["Title"] = "Item details";
}



    <if include-if="Model != null">
        <div class="clearfix">
            <div class="page-title">
                <div class="title_left">
                    <h3>
                        @Localizer["auction details"]
                        <small></small>
                    </h3>
                </div>
                <div class="title_right">
                    <a asp-action="Index"
                       class="btn btn-blue"><span class="fa fa-chevron-left"></span>@Localizer["back_to_list"]</a>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-12 col-sm-12 col-xs-12">
                @{
                    ViewBag.LanguageTabsRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary { { "id", Model.Id } };
                }
                @await Html.PartialAsync("~/Areas/Admin/Views/Shared/partials/_LanguageTabs.cshtml")

                <style>
                    .detials dt, .detials dd {
                        padding: 7px 5px;
                    }
                </style>
                <div class="x_panel">
                    <div class="x_content p-y-5 ">
                        <div class="clearfix auction-detials">
                            <div class="row">
                                <div class="col-md-6">
                                    <dl class="dl-horizontal detials">
                                        <dt>
                                            @Localizer["Title"]
                                        </dt>
                                        <dd>
                                            @Html.DisplayFor(model => model.ItemTitle)
                                        </dd>

                                        <dt>
                                            @Localizer["Category"]
                                        </dt>
                                        <dd>
                                            @Html.DisplayFor(model => model.CategoryName)
                                        </dd>
                                         
                                        <dt>
                                            @Localizer["Status"]
                                        </dt>
                                        <dd>
                                            @Html.DisplayFor(model => model.StatusName)
                                        </dd>

                                        <dt>
                                            @Localizer["Description"]
                                        </dt>
                                        <dd>
                                            @Html.DisplayFor(model => model.ItemDescription)
                                        </dd>

                                        
                                        <if include-if="Model.CurrencyGrade != null ">
                                            <dt>
                                                @Localizer["Currency Grade"]
                                            </dt>
                                            <dd>
                                                @Html.DisplayFor(model => model.CurrencyGrade)
                                            </dd>
                                        </if>

                                        <if include-if="Model.CurrencyDenomination != null">
                                            <dt>
                                                @Localizer["Currency Denomination"]
                                            </dt>
                                            <dd>
                                                @Html.DisplayFor(model => model.CurrencyDenomination)
                                            </dd>
                                        </if>

                                        <if include-if="Model.CurrencyCountry != null">
                                            <dt>
                                                @Localizer["Currency Country"]
                                            </dt>
                                            <dd>
                                                @Html.DisplayFor(model => model.CurrencyCountry)
                                            </dd>
                                        </if>

                                        <if include-if="Model.CurrencyYear != null ">

                                            <dt>
                                                @Localizer["Currency Year"]
                                            </dt>
                                            <dd>
                                                @Html.DisplayFor(model => model.CurrencyYear)
                                            </dd>

                                        </if>


                                        <if include-if="Model.CurrencyPickNumber != null">
                                            <dt>
                                                @Localizer["Currency PickNumber"]
                                            </dt>
                                            <dd>
                                                @Html.DisplayFor(model => model.CurrencyPickNumber)
                                            </dd>
                                        </if>
                                    </dl>
                                </div>
                                <div class="col-md-6">
                                    <dl class="dl-horizontal detials">
                                        <dt>
                                            @Localizer["CreatedDate"]
                                        </dt>
                                        <dd>
                                            @Html.DisplayFor(model => model.CreatedDate)
                                        </dd>
                                        <dt>
                                            @Localizer["ModifiedDate"]
                                        </dt>
                                        <dd>
                                            @Model.ModifiedDate
                                        </dd>
                                       
                                        <dt>
                                            @Localizer["EndDate"]
                                        </dt>
                                        <dd>
                                            @Html.DisplayFor(model => model.EndDate)
                                        </dd>
                                         
                                        <dt>
                                            @Localizer["StartPrice"]
                                        </dt>
                                        <dd>
                                            @Html.DisplayFor(model => model.StartPrice)
                                        </dd>
                                        <dt>
                                            @Localizer["PurchasePrice"]
                                        </dt>
                                        <dd>
                                            @Html.DisplayFor(model => model.PurchasePrice)
                                        </dd>
                                    </dl>
                                </div>




                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>


        <if include-if="Model.ItemImages != null && Model.ItemImages.Count > 0">
            <div class="x_panel">
                <div class="x_content p-y-5 ">

                    <div class="row">
                        @foreach (var item in Model.ItemImages)
                        {
                            <div class="col-md-2 col-sm-3">
                                <div class="gi-card">
                                    <a href="@item.Original" class="gi-image" data-lightbox="images" data-title="@Model.ItemTitle">
                                        <img src="@item.Thumb" class="img-responsive">
                                    </a>
                                </div>
                            </div>
                        }
                    </div>

                </div>
            </div>
        </if>



    <if include-if="Model.StepsHistory != null ">
        <div class="x_panel">
            <div class="x_content">
                <h4 class="m-b1">@Localizer["History"]</h4>
                <div class=" p-y-5" id="StepsHistory">



                    <table class="table table-striped table-bordered">
                        <tr>
                            <th>@Localizer["Current status"]</th>
                            <th>@Localizer["Previous status"]</th>
                            <th>@Localizer["Created date"]</th>
                            <th>@Localizer["Notes"]</th>
                        </tr>
                        <if include-if="Model.StepsHistory.Count > 0">
                            @foreach (var step in Model.StepsHistory)
                            {
                                <tr>
                                    <td>@step.CurrentStatusName</td>
                                    <td>@step.PreviousStatusName</td>
                                    <td>@step.CreatedDate</td>
                                    <td>@step.Notes</td>
                                </tr>
                            }
                        </if>
                    </table>

                </div>
            </div>
        </div>
                </if>




        <if include-if="Model.SellerProfile != null">
            @{
                var Seller = Model.SellerProfile;
            }
            <div class="x_panel">
                <div class="x_content p-y-5 ">

                    <div class="col-md-12 col-sm-12 " id="@Seller.Id">
                        <div class="gi-card">
                            <a href="@Seller.Photo" class="gi-image" data-lightbox="images" data-title="@Seller.FullName">
                                <img src="@Seller.Photo">
                            </a>
                            <div class="gi-info">

                                <header class="gi-header">
                                    <h3>@Seller.FullName</h3>
                                </header>


                                <div class="gi-suumary">
                                    @Html.Raw(Seller.FullName)
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>


        </if>

        <if include-if="Model.ProcessActions != null && Model.ProcessActions.Count > 0">
            <div class="x_panel">
                <div class="x_content p-y-5 ">
                    <div class="" id="form">
                        @{
                            List<ProcessActionModel> Actions = Model.ProcessActions;
                        }
                        <div class="pos-actions ">
                            <form asp-action="setAction" method="post" class="form m-y-5" id="takenAction">
                                <input type="hidden" name="ReqId" value="@Model.Id" />
                                <div class="form-group clearfix">
                                    <label class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["l_status"] </label>
                                    <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                                        @foreach (ProcessActionModel act in Actions)
                                        {
                                            <span class="m-x-3">
                                                <label for="Action-@act.ActionId">
                                                    <input type="radio" name="ActionId" id="Action-@act.ActionId" value="@act.ActionId" class="check" data-note='@(act.NoteMandatory ? "true" : "false" )' required @(Model.StatusName)>
                                                    <span class="check-txt">@act.Name</span>
                                                </label>
                                            </span>
                                        }
                                        <div class="actionId-errors"></div>
                                    </div>
                                </div>

                                <div class="form-group clearfix">
                                    <label class="control-label col-md-2 col-sm-3 col-xs-12 ">@Localizer["l_notes"] </label>
                                    <div class="col-md-10 col-lg-9 col-sm-9 col-xs-12">
                                        <textarea rows="5" class="form-control action_note" name="Notes"></textarea>
                                    </div>
                                </div>
                                <div class="form-group">
                                    <div class="col-md-6 col-md-offset-2 col-sm-offset-3 col-sm-6 col-xs-12 ">
                                        <input type="submit" class="btn btn-success p-x-5 ut-save-btn" name="save" value="@Localizer["send"]">

                                    </div>
                                </div>
                            </form>

                        </div>

                    </div>
                </div>
            </div>




        </if>




    </if>
<if exclude-if="Model != null">
    <partial name="~/Areas/Admin/Views/Shared/_empty.cshtml" />
</if>





@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script src="~/Admin/js/auctions.min.js"></script>


    <script src="~/Admin/js/lightbox.min.js"></script>
    <script>


        lightbox.option({
            'resizeDuration': 400,
            'wrapAround': true,
            'showImageNumberLabel': false
        })
    </script>

}
